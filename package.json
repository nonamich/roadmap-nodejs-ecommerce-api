{
  "name": "roadmap-nodejs-ecommerce-api",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run --concurrency=100% --parallel dev",
    "predev": "pnpm docker:dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build",
    "docker:dev": "docker compose -f compose.infra.yml -f compose.dev.yml up -d",
    "db:migrate": "pnpm -r db:migrate"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@apps/*"
    ]
  },
  "dependencies": {
    "turbo": "^2.4.0"
  }
}
