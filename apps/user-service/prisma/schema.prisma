generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client/user"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  email    String @unique
  password String
}
