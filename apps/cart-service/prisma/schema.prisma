generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@packages/shared/db/cart"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CartItem {
  productId String
  userId    String
  quantity  Int
  price     Float

  @@unique([productId, userId])
}
