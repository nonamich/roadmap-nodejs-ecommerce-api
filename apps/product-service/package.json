    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "start": "node .",
    "build": "nest build",
    "dev": "nest start --debug :9227 --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
