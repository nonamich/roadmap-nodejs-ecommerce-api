{
  "name": "@/grpc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "clean-dist": "rm -rf dist",
    "protoc": "make protoc",
    "prebuild": "pnpm clean-dist && pnpm protoc"
  },
  "exports": {
    "./utils": "./dist/utils.js",
    "./nest": "./dist/nest/index.js",
    "./pb/*": "./dist/pb/*.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@grpc/reflection": "^1.0.4",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.8",
    "@nestjs/core": "^11.0.8",
    "@nestjs/microservices": "^11.0.8",
    "@nonamich/ts-proto": "^1.0.0",
    "@/configs": "workspace:*",
    "@types/node": "^22.13.1",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "*",
    "@grpc/proto-loader": "*",
    "@grpc/reflection": "*",
    "@nestjs/common": "*",
    "@nestjs/core": "*",
    "@nestjs/microservices": "*",
    "protobufjs": "*",
    "rxjs": "*"
  }
}
