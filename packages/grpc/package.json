{
  "name": "@packages/grpc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "pnpm run build -w"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@packages/configs": "workspace:*",
    "@types/node": "^22.10.7",
    "pkgroll": "^2.6.1",
    "protobufjs": "^7.4.0",
    "rxjs": "^7.8.1",
    "ts-proto": "^2.6.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "protobufjs": "^7.4.0",
    "rxjs": "^7.8.1"
  }
}
