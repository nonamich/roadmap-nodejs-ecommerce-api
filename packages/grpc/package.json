{
  "name": "@packages/grpc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pkgroll --sourcemap",
    "dev": "pnpm run build -w"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@nestjs/microservices": "^11.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@packages/configs": "workspace:*",
    "@types/node": "^22.10.7",
    "pkgroll": "^2.6.1",
    "reflect-metadata": "^0.2.2",
    "ts-proto": "^2.6.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
